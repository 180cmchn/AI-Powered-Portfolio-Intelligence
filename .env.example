# Copy to .env. Secrets stay on the backend and never enter the browser.
APP_MODE=live
APP_HOST=127.0.0.1
APP_PORT=8765
# Choose any actually accessible model supporting function tools.
MODEL_NAME=
MODEL_PROTOCOL=responses
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_KEY_ENV=MODEL_API_KEY
MODEL_API_KEY=
# Optional search service: disabled | tavily | brave
SEARCH_PROVIDER=disabled
SEARCH_KEY_ENV=TAVILY_API_KEY
TAVILY_API_KEY=
BRAVE_API_KEY=
QUOTE_PROVIDER=eastmoney

# Research data is separate from spot quotes. Optional authenticated alternative: tushare.
RESEARCH_PROVIDER=eastmoney
TUSHARE_TOKEN=
