# Copy to .env. Secrets stay on the backend and never enter the browser.
APP_MODE=live
APP_HOST=127.0.0.1
APP_PORT=8765
# Choose any actually accessible model supporting function tools.
MODEL_NAME=
MODEL_PROTOCOL=responses
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_KEY_ENV=MODEL_API_KEY
MODEL_API_KEY=
# Hosted search uses the same model endpoint and MODEL_API_KEY; no search-service key.
# Requires a Responses endpoint actually supporting native web_search + local functions.
MODEL_NATIVE_SEARCH=true
QUOTE_PROVIDER=eastmoney
# Free public website quote fallback; none disables it. Does not bypass HTTP 429.
QUOTE_FALLBACK_PROVIDER=sina

# Research data is separate from spot quotes. Optional authenticated alternative: tushare.
RESEARCH_PROVIDER=eastmoney
TUSHARE_TOKEN=
